[Unit]
Description=TraceShield OpenClaw Control UI HTTPS tunnel
After=network-online.target openclaw-gateway.service
Wants=network-online.target openclaw-gateway.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:18789 --no-autoupdate --metrics 127.0.0.1:20242
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target